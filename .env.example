# Create a form at Formspree (or use another JSON-compatible form service) and
# paste its HTTPS endpoint here. Vite embeds this value at build time.
VITE_CONTACT_FORM_ENDPOINT="https://formspree.io/f/meaodopp"

# Create your owner account at /admin/login. Admin credentials are stored in SQLite.
# Optional trusted frontend origin when frontend and API use different origins.
ADMIN_ORIGIN=http://localhost:3000
